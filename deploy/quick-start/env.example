# Optional settings for the ready-made EconQuest image. Copy to .env in this folder and edit.
# Every line is optional. Keys can also be added later in the app: Menu > Settings > API keys.

# Port on this computer: the app opens at http://localhost:3737
PORT=3737

# Light mode for a modest laptop (4 GB of memory): no AI model on this computer (the council uses
# your own Gemini key, or stays off), no GDELT news files (saves about 3.4 GB of the first
# download), and only the countries on your watchlist downloaded. See docs/INSTALL.md.
# LIGHT_MODE=on

# AI model. "ollama" (free, runs on your computer) or "gemini" (needs your own Gemini key).
DEFAULT_AI_PROVIDER=ollama
# GEMINI_API_KEY=

# Ollama. Default: the Ollama app on this computer. With the bundled Ollama
# (docker compose --profile ollama up -d) use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_QUICK_MODEL=qwen2.5:7b
# Referee (summaries, explanations, debate): 32B. Never an 8B model.
OLLAMA_DEEP_MODEL=qwen2.5:32b

# Free FRED key for official 10-year yields: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=

# Time zone for the morning brief, e.g. Europe/London
TZ=UTC

# A specific release instead of the newest, e.g. ghcr.io/e-conquest/econquest:0.1.0
# ECONQUEST_IMAGE=ghcr.io/e-conquest/econquest:latest
