# EconQuest settings. Copy this file to .env (cp .env.example .env) and fill in what you use.
# Every setting is optional. After editing, restart the app, then run `npm run check:data`
# (or open Tools > Data connections) to see what connects and why anything does not.
# The full list of sources, what each fills and how to set it up: docs/DATA_SOURCES.md
#
# Free sources that need no key, so nothing to set here: World Bank, World Bank debt
# statistics (IDS, QEDS), IMF, GDELT, Polymarket, Kalshi, New York Fed, spot FX
# (open.er-api.com), ECB rates (Frankfurter), BIS, WITS, CFTC Commitments of Traders,
# US Treasury TIC, OECD data via DBnomics, World Bank Pink Sheet (commodity prices), UN Comtrade
# (preview), FRED download, Brazil Treasury.
# PINK_SHEET_URL=""        # only if the World Bank page stops linking the monthly workbook
#
# IMF reserves and balance of payments (api.imf.org) find their series by the IMF's own indicator
# names. Only if `npm run check:data` says a name did not match, set the series key here, with
# {ISO3} for the country (the check shows the dataset's dimension order), for example:
# IMF_RESERVES_KEY="{ISO3}.<indicator>.<unit>.M"
IMF_RESERVES_KEY=""
IMF_CA_KEY=""
IMF_IMPORTS_KEY=""
# IMF COFER (world reserve currency shares), only if the check says the world code was not found.
IMF_COFER_KEY=""

# ------------------------------------------------------------------------------------------
# AI model (council summary, debate replies, agent choice). Pick one provider.
# ------------------------------------------------------------------------------------------
# "ollama" (on this computer), "gemini" (Google, needs a key), "hybrid_failover" (Ollama,
# then Gemini), or "openai_compatible" (LM Studio, vLLM, llama.cpp).
DEFAULT_AI_PROVIDER="ollama"

# Ollama. Running the app with `npm run dev` on the Mac: http://localhost:11434.
# Inside Docker, talking to Ollama on the Mac: http://host.docker.internal:11434.
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_QUICK_MODEL="qwen2.5:7b"
OLLAMA_DEEP_MODEL="deepseek-r1:8b"

# Gemini. Free key: aistudio.google.com > Get API key. Can also be pasted under
# Menu > Settings > AI model key; a key saved there is used instead of this one.
GEMINI_API_KEY=""

# Local OpenAI-style server, only if DEFAULT_AI_PROVIDER="openai_compatible".
OPENAI_COMPATIBLE_BASE_URL=""
OPENAI_COMPATIBLE_MODEL=""

# ------------------------------------------------------------------------------------------
# Free sources that need your own key
# ------------------------------------------------------------------------------------------
# Every key in this section can also be pasted in the app under Menu > Settings > Data API keys
# (Cmd/Ctrl + comma). A value saved there is used instead of the one here.
#
# FRED API: free key from fred.stlouisfed.org > My Account > API Keys. Optional: without it
# the same yields come from the FRED download, which needs no key.
FRED_API_KEY=""

# Turkey 10Y yield from the central bank's EVDS. Both are needed:
#   EVDS_API_KEY: free; register at evds3.tcmb.gov.tr, then copy the key from your profile.
#   EVDS_TR10Y_SERIES: the 10Y bond yield series code shown in EVDS (starts with "TP.").
# Until both are set, Turkey's yield reads Missing.
EVDS_API_KEY=""
EVDS_TR10Y_SERIES=""

# US EIA: daily Brent and WTI spot prices. Free key: eia.gov/opendata > Register. Optional:
# without it oil comes monthly from the World Bank Pink Sheet.
EIA_API_KEY=""

# UN Comtrade: trade partners and export mix. Optional: without a key the app uses the public
# preview (few requests allowed). Free key: comtradeplus.un.org > My Comtrade > My API portal.
COMTRADE_API_KEY=""

# ------------------------------------------------------------------------------------------
# Your own paid data (off unless you switch it on). CDS reads Missing until you do.
# ------------------------------------------------------------------------------------------
# 5Y sovereign CDS. No free source exists.
# Option 1, a file you keep (an export from Bloomberg, LSEG or S&P/Markit):
#   CDS_FEED="csv", CDS_CSV_PATH="/Users/you/cds.csv" (full path), with a header row:
#   iso3,date,cds5y_bps,source      e.g.  BRA,2026-11-03,168.2,Bloomberg
#   The latest date per country is used; the file is re-read when it changes.
# Option 2, LSEG Data Platform with your own login:
#   CDS_FEED="lseg", LSEG_APP_KEY, LSEG_USERNAME, LSEG_PASSWORD, and LSEG_CDS_RICS as
#   ISO3=RIC pairs from your entitlement, e.g. "BRA=<ric>,TUR=<ric>".
CDS_FEED=""
CDS_CSV_PATH=""
LSEG_APP_KEY=""
LSEG_USERNAME=""
LSEG_PASSWORD=""
LSEG_CDS_RICS=""
# LSEG_API_BASE="https://api.refinitiv.com"   # only if LSEG gave you a different address

# ------------------------------------------------------------------------------------------
# App
# GDELT_REFRESH_DAYS="7"      # how often each country's GDELT news tone is pulled (90 = quarterly)
# ------------------------------------------------------------------------------------------
# PORT="3000"                 # where the app listens
# DATA_DIR="./data"           # where pulled figures are saved between runs
# Integration API for other apps (/api/v1/integration). Without these, a random key and
# secret are made each time the app starts.
# SMCR_INTEGRATION_API_KEY=""
# SMCR_WEBHOOK_HMAC_SECRET=""

# ------------------------------------------------------------------------------------------
# Settings saved in the app (Menu > Settings) go to data/local/settings.json on this computer.
# Changes there are accepted only from this computer. docker-compose.yml sets this to "true"
# itself, because there the browser's requests arrive from Docker's network and the port is
# published on this computer only. Set "true" outside Docker only if you trust your network.
# ------------------------------------------------------------------------------------------
SETTINGS_ALLOW_REMOTE=""
