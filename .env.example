# GEMINI_API_KEY: Required for Cloud Gemini AI API calls (optional when running in local Ollama mode).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# ==============================================================================
# SELF-HOSTED DOCKER & LOCAL OLLAMA AGENT CONFIGURATION (macOS & Windows)
# ==============================================================================
# DEFAULT_AI_PROVIDER: 'ollama' | 'hybrid_failover' | 'gemini' | 'openai_compatible'
DEFAULT_AI_PROVIDER="ollama"

# OLLAMA_BASE_URL:
# - Local Node.js dev on host: http://localhost:11434
# - Docker connecting to Mac (Apple Silicon Metal) or Windows host Ollama: http://host.docker.internal:11434
# - Docker connecting to bundled Ollama container: http://ollama:11434
OLLAMA_BASE_URL="http://host.docker.internal:11434"

# Per-Phase Local Model Assignment for the 12-Agent Sovereign Council:
# OLLAMA_QUICK_MODEL powers Phase 1 (9 Specialist Sub-Agents + Devil's Advocate Debates) & Phase 2 (Contagion Cascade)
OLLAMA_QUICK_MODEL="qwen2.5:7b"

# OLLAMA_DEEP_MODEL powers Phase 3 (3 Supreme Council Referees & Policy Document NLP)
OLLAMA_DEEP_MODEL="deepseek-r1:8b"

# Optional OpenAI-Compatible Local Server (vLLM / LM Studio / llama.cpp)
OPENAI_COMPATIBLE_BASE_URL="http://host.docker.internal:8000/v1"
OPENAI_COMPATIBLE_MODEL="gpt-4o"

# FRED_API_KEY (optional): free key from https://fred.stlouisfed.org (My Account > API Keys).
# Used for official OECD 10Y government yields. Without it the app uses FRED's public CSV download.
FRED_API_KEY=""
