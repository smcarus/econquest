              "countryName": "Brazil",
              "reading": "The policy rate of 13.75% is far above inflation of 4.4%, so policy is tight.",
              "figures": [
                {
                  "label": "Policy rate",
                  "value": "13.75%",
                  "source": "BIS policy rates, Oct 2026 (frozen test input)",
                  "tag": "official"
                },
                {
                  "label": "CPI inflation",
                  "value": "4.4%",
                  "source": "BCB IPCA, Sep 2026 (frozen test input)",
                  "tag": "official"
                }
              ],
              "weight": 0.8,
              "stance": [
                {
                  "dim": "policy",
                  "call": "tight"
                }
              ]
            }
          ],
          "missing": []
        }
      ],
      "expect": {
        "headline": "\\b(tight|restrictive|yes)\\b",
        "mention": [
          "Brazil"
        ],
        "forbid": "\\bpolicy (is|looks|appears) (loose|easy|accommodative)\\b",
        "maxRemoved": 1
      }
    },
