{
  "name": "econquest-terminal",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "go": "bash scripts/econquest.sh",
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "update": "bash scripts/update.sh",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.strict.json",
    "size:check": "tsx scripts/size-check.ts",
    "test": "tsx --test \"tests/*.test.ts\"",
    "test:smoke": "node tests/smoke/ui-smoke.mjs",
    "test:journeys": "node tests/smoke/journeys.mjs",
    "check:data": "tsx scripts/check-connections.ts",
    "check:imf": "tsx scripts/imf-codes.ts",
    "check:vintages": "tsx scripts/vintage-probe.ts",
    "check:success": "tsx scripts/success-measures.ts",
    "weo:vintages": "tsx scripts/weo-vintages.ts",
    "weo:pull": "tsx scripts/weo-pull.ts",
    "sanctions:pull": "tsx scripts/sanctions-pull.ts",
    "gpr:pull": "tsx scripts/gpr-pull.ts",
    "ucdp:pull": "tsx scripts/ucdp-pull.ts",
    "signals:evaluate": "tsx scripts/signals-evaluate.ts",
    "preload": "tsx server.ts --preload",
    "daily": "tsx server.ts --daily",
    "daily:status": "tsx scripts/daily-status.ts",
    "gdelt:pull": "tsx scripts/gdelt-pull.ts",
    "gdelt:daily": "tsx scripts/gdelt-daily.ts",
    "record:feeds": "tsx scripts/record-feeds.ts && tsx scripts/public-feeds.ts",
    "record:public": "tsx scripts/public-feeds.ts",
    "backtest": "tsx scripts/backtest.ts",
    "feedback:export": "tsx scripts/feedback-export.ts",
    "council:regress": "tsx scripts/council-regress.ts",
    "council:record": "tsx scripts/council-record.ts",
    "docs:licences": "tsx scripts/docs-licences.ts",
    "quests:check": "tsx scripts/quests-check.ts",
    "quests:resolve": "tsx scripts/quests-resolve.ts",
    "quests:entries": "tsx scripts/quests-entries.ts",
    "quests:stats": "tsx scripts/quests-stats.ts",
    "quests:generate": "tsx scripts/quests-generate.ts",
    "quests:approve": "tsx scripts/quests-approve.ts",
    "quests:brief": "tsx scripts/quests-brief.ts",
    "quests:digest": "tsx scripts/quests-digest.ts",
    "quests:run-tests": "tsx scripts/quests-run-tests.ts",
    "quests:board": "tsx scripts/quests-board.ts",
    "quests:dataset": "tsx scripts/quests-dataset.ts",
    "council:time": "tsx scripts/council-time.ts",
    "docs:methods": "tsx scripts/docs-methods.ts",
    "docs:track-record": "tsx scripts/docs-track-record.ts",
    "docs:glossary": "tsx scripts/docs-glossary.ts",
    "users": "tsx scripts/users.ts",
    "backup:drill": "tsx scripts/backup-drill.ts",
    "forecast:evaluate": "tsx scripts/forecast-evaluate.ts",
    "forecast:worst": "tsx scripts/forecast-worst.ts",
    "mac:validate": "tsx scripts/mac-validate.ts",
    "public:export": "bash scripts/public-export.sh",
    "aiddata:summary": "tsx scripts/aiddata-summary.ts",
    "reviews:summary": "tsx scripts/expert-reviews-summary.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
